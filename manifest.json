{
  "manifest_version": 3,
  "name": "ScreenCraft — Screen Recorder",
  "description": "Record your screen, camera and voice — a Loom-style screen recorder.",
  "version": "1.0.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icons/icon.png",
    "default_title": "ScreenCraft — Screen Recorder"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup/popup.css", "popup/popup.html", "icons/icon.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
